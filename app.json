{
  "expo": {
    "name": "Tamil AI Chat",
    "slug": "tamil-ai-chat",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#075E54"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smk1.tamilaichat"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#075E54"
      },
      "package": "com.smk1.tamilaichat"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8fa7f4af-082b-4b25-8910-5d79cabafdf8"
      }
    },
    "plugins": [
      "./plugins/withExpoUpdatesKotlinFix"
    ],
    "updates": {
      "url": "https://u.expo.dev/8fa7f4af-082b-4b25-8910-5d79cabafdf8",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "NEVER"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
